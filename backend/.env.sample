KAKAO_REST_API_KEY=

AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com/v1

AI_WEB_SEARCH_ENABLED=false
AI_WEB_SEARCH_PROVIDER=naver_search
AI_WEB_SEARCH_SUMMARY_PROVIDER=
AI_WEB_SEARCH_GROUNDING_SUPPORTED=false

AI_INTENT_MODEL=gpt-5-mini
AI_QUERY_REPAIR_MODEL=gpt-5-nano
AI_RERANK_MODEL=gpt-5-nano
AI_WEB_SEARCH_MODEL=gpt-5-nano
AI_WEB_SEARCH_REASONING_EFFORT=
AI_REASONING_EFFORT=
AI_WEB_SEARCH_MAX_CANDIDATES=1
AI_WEB_SEARCH_MAX_OUTPUT_TOKENS=800
AI_REASON_MODEL=gpt-5-nano
AI_REQUEST_TIMEOUT=20
AI_RERANK_TIMEOUT=20
AI_SEARCH_RERANK_MAX_CANDIDATES=8
AI_RERANK_REASONING_EFFORT=low
AI_RERANK_CACHE_TTL=900
AI_SEARCH_ROUTE_CATEGORY_REQUESTS=true

NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
NAVER_SEARCH_DISPLAY=5
NAVER_SEARCH_SORT=sim

# =========================
# Database
# =========================
# sqlite (기본) | postgres
DB_ENGINE=sqlite
POSTGRES_DB=life_infra_map
POSTGRES_USER=life_infra_map
POSTGRES_PASSWORD=life_infra_map
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DB_CONN_MAX_AGE=60
DB_CONNECT_TIMEOUT=5

# pgAdmin (docker compose, 개발 편의용)
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
