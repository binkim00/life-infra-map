TAG_COLLECTION_DAILY_API_LIMIT=25000
TAG_COLLECTION_QUOTA_PERCENT=90
TAG_COLLECTION_DAILY_PLACE_LIMIT=100
TAG_COLLECTION_REVISIT_DAYS=90
TAG_COLLECTION_WORKER_BATCH_SIZE=10
TAG_COLLECTION_POLL_SECONDS=30
TAG_COLLECTION_STALE_LOCK_MINUTES=30
TAG_COLLECTION_MODE=bootstrap
TAG_COLLECTION_BOOTSTRAP_TIER_WEIGHTS=70,15,10,5
TAG_COLLECTION_BOOTSTRAP_CATEGORY_MAX_SHARE=40
TAG_COLLECTION_PRIORITY_CAFE=20
TAG_COLLECTION_PRIORITY_RESTAURANT=20
TAG_COLLECTION_PRIORITY_TOURISM=12
TAG_COLLECTION_PRIORITY_CITY_PARK=12
TAG_COLLECTION_PRIORITY_LIBRARY=18
TAG_COLLECTION_PRIORITY_BEACH=10
TAG_COLLECTION_PRIORITY_PARKING=8
TAG_COLLECTION_PRIORITY_TOILET=8
TAG_COLLECTION_PRIORITY_SHELTER=6
TAG_COLLECTION_RATE_LIMIT_ENABLED=true
TAG_COLLECTION_NAVER_RPS=10
TAG_COLLECTION_DEFAULT_RPS=2
TAG_COLLECTION_STRUCTURED_FIRST=true
TAG_COLLECTION_AI_EXTRACTOR_ENABLED=false
TAG_COLLECTION_AI_PRIORITY_THRESHOLD=80
TAG_COLLECTION_AI_MAX_CALLS_PER_PLACE=1
TAG_COLLECTION_AI_MODEL=gpt-5-nano
TAG_COLLECTION_AI_DAILY_LIMIT=100
TAG_COLLECTION_READY_EVIDENCE_COVERAGE=0.20
TAG_COLLECTION_READY_TAG_COVERAGE=0.10
TAG_COLLECTION_READY_HIGH_CONFIDENCE=0.40
TAG_COLLECTION_READY_MAX_CONFLICT=0.10
TAG_COLLECTION_READY_MAX_STALE=0.40
DATA_GO_KR_REST_RESTAURANT_SERVICE_KEY=
DATA_GO_KR_BAKERY_SERVICE_KEY=

AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com/v1

AI_WEB_SEARCH_ENABLED=false
AI_WEB_SEARCH_PROVIDER=naver_search
AI_WEB_SEARCH_SUMMARY_PROVIDER=
AI_WEB_SEARCH_GROUNDING_SUPPORTED=false

AI_INTENT_MODEL=gpt-5-mini
AI_QUERY_REPAIR_MODEL=gpt-5-nano
AI_RERANK_MODEL=gpt-5-nano
AI_WEB_SEARCH_MODEL=gpt-5-nano
AI_WEB_SEARCH_REASONING_EFFORT=
AI_REASONING_EFFORT=
AI_WEB_SEARCH_MAX_CANDIDATES=1
AI_WEB_SEARCH_MAX_OUTPUT_TOKENS=800
AI_REASON_MODEL=gpt-5-nano
AI_REQUEST_TIMEOUT=20
AI_RERANK_TIMEOUT=20
AI_SEARCH_RERANK_MAX_CANDIDATES=8
AI_RERANK_REASONING_EFFORT=low
AI_RERANK_CACHE_TTL=900
AI_SEARCH_ROUTE_CATEGORY_REQUESTS=true
AI_SEARCH_WEIGHT_CONDITION=0.20
AI_SEARCH_WEIGHT_TAG=0.10
AI_SEARCH_WEIGHT_SEMANTIC=0.35
AI_SEARCH_WEIGHT_DISTANCE=0.10
AI_SEARCH_WEIGHT_EVIDENCE=0.10
AI_SEARCH_WEIGHT_FRESHNESS=0.05
AI_SEARCH_WEIGHT_RELIABILITY=0.10
SEMANTIC_RETRIEVAL_ENABLED=false
SEMANTIC_EMBEDDING_PROVIDER=

NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
NAVER_SEARCH_DISPLAY=5
NAVER_SEARCH_SORT=sim

# =========================
# Database
# =========================
# Django와 Spring이 공유하는 PostgreSQL/PostGIS
POSTGRES_DB=life_infra_map
POSTGRES_USER=life_infra_map
POSTGRES_PASSWORD=life_infra_map
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DB_CONN_MAX_AGE=60
DB_CONNECT_TIMEOUT=5

# pgAdmin (docker compose, 개발 편의용)
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# =========================
# File storage
# =========================
# local (backend/media/) | s3 (MinIO / AWS S3)
FILE_STORAGE_BACKEND=local
S3_ACCESS_KEY=life_infra_map
S3_SECRET_KEY=life_infra_map_secret
S3_BUCKET=life-infra-map-media
S3_REGION=us-east-1
# MinIO 를 쓸 때만 지정합니다. 실제 AWS S3 로 가면 비워 두세요.
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_PUBLIC_DOMAIN=127.0.0.1:9000/life-infra-map-media
S3_ADDRESSING_STYLE=path
# 로컬 MinIO 는 http:, 배포 S3 는 https:
S3_URL_PROTOCOL=https:
S3_QUERYSTRING_AUTH=false
S3_PORT=9000
S3_CONSOLE_PORT=9001

# =========================
# Spring 서비스와 공유하는 JWT
# =========================
# spring-api 의 app.jwt.secret 과 같은 값이어야 합니다. 32바이트 이상.
JWT_SECRET=local-dev-secret-key-at-least-32-bytes-long
JWT_ALGORITHM=HS256
