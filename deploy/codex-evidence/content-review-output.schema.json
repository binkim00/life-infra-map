{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["results"],
  "properties": {
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "quote_hash", "decision", "source_url", "source_span", "reason"],
        "properties": {
          "id": {"type": "integer"},
          "quote_hash": {"type": "string"},
          "decision": {"type": "string", "enum": ["approve", "hold"]},
          "source_url": {"type": "string"},
          "source_span": {"type": "string"},
          "reason": {"type": "string"}
        }
      }
    }
  }
}
