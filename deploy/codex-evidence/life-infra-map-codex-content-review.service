[Unit]
Description=Life Infra Map Codex second-pass evidence content review
After=docker.service network-online.target life-infra-map-codex-evidence.service
Wants=network-online.target
Requires=docker.service
OnFailure=life-infra-map-codex-content-review-failure.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/life-infra-map/app
Environment=HOME=/home/ubuntu
Environment=CODEX_HOME=/home/ubuntu/.codex
Environment=CODEX_CONTENT_REVIEW_LIMIT=5
Environment=CODEX_CONTENT_REVIEW_APPLY=1
ExecStartPre=+/usr/bin/install -d -o ubuntu -g ubuntu -m 0700 /home/ubuntu/life-infra-map/runtime/codex-evidence/content-review
ExecStart=/usr/bin/flock -w 900 /run/lock/life-infra-map-codex-evidence.lock /home/ubuntu/life-infra-map/app/deploy/codex-evidence/run-codex-content-review.sh
TimeoutStartSec=60min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/.codex /home/ubuntu/life-infra-map/runtime/codex-evidence /run/lock
InaccessiblePaths=-/home/ubuntu/.ssh -/home/ubuntu/.aws -/home/ubuntu/life-infra-map/app/backend/.env -/home/ubuntu/life-infra-map/app/deploy/db/.env

[Install]
WantedBy=multi-user.target
