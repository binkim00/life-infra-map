[Unit]
Description=Prune old Life Infra Map Docker build cache
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/life-infra-map/app
ExecStart=/usr/bin/python3 /home/ubuntu/life-infra-map/app/deploy/disk-maintenance/disk_guard.py cleanup
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
InaccessiblePaths=-/home/ubuntu/.ssh -/home/ubuntu/.aws -/home/ubuntu/life-infra-map/app/backend/.env -/home/ubuntu/life-infra-map/app/deploy/db/.env
